# Real ADB binary fetched by setup.py — not committed. The repo deliberately
# ships no working ADB, and adb/adb is a Linux/macOS binary in a Windows repo.
adb/adb

# Python bytecode from running the toolkit or setup scripts
__pycache__/

# The APKs under apks/ are committed on purpose — that is what makes an Install button work offline.
# Only a download that died part way through stays out of git.
apks/*.part
